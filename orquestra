#!/usr/bin/env bash
# Resolve o caminho real caso seja um symlink
REAL_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_PATH")" && pwd)"

if [ -z "$TMUX" ]; then
    # Inicia uma sessão tmux efêmera para permitir uso de split-window (ChatOps)
    tmux new-session -d -s "orquestra_$$" "python3 '$SCRIPT_DIR/orquestra.py' $*"
    tmux set-option -g mouse on
    exec tmux attach-session -t "orquestra_$$"
else
    exec python3 "$SCRIPT_DIR/orquestra.py" "$@"
fi
