#!/usr/bin/env bash
# Launcher do Orquestra. Resolve o caminho real caso seja um symlink em ~/.local/bin,
# então `orquestra` funciona de qualquer pasta (a pasta atual vira o projeto).
REAL_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_PATH")" && pwd)"

# Interface oficial = TUI (Textual). `orquestra --repl` cai no REPL antigo
# (headless/debug). Qualquer outro argumento é repassado.
if [ "$1" = "--repl" ]; then
    shift
    exec python3 "$SCRIPT_DIR/orquestra.py" "$@"
fi

exec python3 "$SCRIPT_DIR/orquestra_tui.py" "$@"
